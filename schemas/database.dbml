Project meet_v3 {
  database_type: 'PostgreSQL'
  Note: 'Architecture 1.3 pre-migration design blueprint. PostgreSQL 18 + PostGIS. After P0-006 this file becomes generated/verified from Drizzle schema+migrations per SCHEMA_GOVERNANCE.md.'
}

Enum user_status { ACTIVE RESTRICTED SUSPENDED DELETION_PENDING DELETED }
Enum event_state { DRAFT PENDING_REVIEW PUBLISHED CANCELLED COMPLETED REMOVED ARCHIVED }
Enum occurrence_state { SCHEDULED JOIN_CLOSED CANCELLED COMPLETED REMOVED }
Enum event_origin { IMPORTED ORGANIZATION COMMUNITY PLATFORM }
Enum event_access { PUBLIC UNLISTED PRIVATE ORGANIZATION_ONLY }
Enum admission_mode { NONE FREE EXTERNAL_TICKET INTERNAL_TICKET }
Enum participation_mode { OPEN APPROVAL_REQUIRED INVITE_ONLY DISABLED }
Enum waitlist_policy { DISABLED ENABLED }
Enum place_type { PUBLIC_VENUE OUTDOOR PRIVATE_HOME }
Enum participation_state { REQUESTED WAITLISTED SLOT_OFFERED CONFIRMED REJECTED EXPIRED CANCELLED_BY_USER REMOVED_BY_HOST ATTENDED NO_SHOW }
Enum pod_state { DRAFT OPEN FULL CLOSED CANCELLED COMPLETED REMOVED }
Enum pod_member_state { REQUESTED CONFIRMED REJECTED LEFT REMOVED }
Enum org_status { UNCLAIMED CLAIM_PENDING VERIFIED SUSPENDED CLOSED }
Enum org_role { OWNER ADMIN EVENT_MANAGER MODERATOR ANALYST BILLING }
Enum verification_status { CREATED PENDING VERIFIED FAILED EXPIRED REVOKED }
Enum media_status { UPLOADING QUARANTINED PROCESSING READY REJECTED DELETED }
Enum ingestion_run_status { CREATED RUNNING SUCCEEDED PARTIAL FAILED }
Enum report_status { SUBMITTED TRIAGED LINKED_TO_CASE CLOSED }
Enum case_state { OPEN TRIAGED INVESTIGATING ACTIONED APPEALED CLOSED }
Enum appeal_state { SUBMITTED UNDER_REVIEW UPHELD OVERTURNED PARTIALLY_OVERTURNED CLOSED }
Enum conversation_type { OCCURRENCE POD CONNECTION ORGANIZATION_ANNOUNCEMENT }
Enum delivery_status { QUEUED SENT DELIVERED FAILED_RETRYABLE FAILED_FINAL SUPPRESSED }
Enum job_status { REQUESTED RUNNING SUCCEEDED FAILED CANCELLED }
Enum flag_change_status { PENDING APPROVED REJECTED APPLIED EXPIRED }
Enum device_integrity_provider { APP_ATTEST PLAY_INTEGRITY }

Table users {
  id uuid [pk]
  auth_subject varchar [not null, unique]
  status user_status [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz
}

Table user_public_profiles {
  user_id uuid [pk, ref: > users.id]
  nickname varchar [not null]
  bio text
  avatar_media_id uuid [ref: > media_assets.id]
  home_city_id uuid [ref: > cities.id]
  gender_display varchar
  visibility varchar [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table user_private_profiles {
  user_id uuid [pk, ref: > users.id]
  date_of_birth date [not null]
  gender varchar
  phone_e164 varchar
  email_normalized varchar
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table interests {
  id uuid [pk]
  slug varchar [unique, not null]
  parent_id uuid [ref: > interests.id]
}

Table user_interests {
  user_id uuid [ref: > users.id]
  interest_id uuid [ref: > interests.id]
  weight int
  created_at timestamptz [not null]
  indexes { (user_id, interest_id) [unique] }
}

Table user_languages {
  user_id uuid [ref: > users.id]
  locale varchar [not null]
  proficiency varchar
  indexes { (user_id, locale) [unique] }
}

Table user_preferences {
  user_id uuid [pk, ref: > users.id]
  discovery jsonb [not null]
  privacy jsonb [not null]
  updated_at timestamptz [not null]
}

Table notification_preferences {
  user_id uuid [pk, ref: > users.id]
  preferences jsonb [not null]
  quiet_hours jsonb
  updated_at timestamptz [not null]
}

Table user_devices {
  id uuid [pk]
  user_id uuid [ref: > users.id, not null]
  platform varchar [not null]
  device_install_id varchar [not null]
  push_provider varchar
  push_token varchar
  app_version varchar
  build_number varchar
  runtime_version varchar
  last_seen_at timestamptz [not null]
  revoked_at timestamptz
  created_at timestamptz [not null]
  indexes { (user_id, device_install_id) [unique] }
}

Table device_attestations {
  id uuid [pk]
  user_device_id uuid [ref: > user_devices.id, not null]
  provider device_integrity_provider [not null]
  key_reference varchar
  public_key bytea
  assertion_counter bigint
  latest_verdict jsonb
  risk_reason_codes jsonb
  verified_at timestamptz
  expires_at timestamptz
  updated_at timestamptz [not null]
  indexes { (user_device_id, provider) [unique] }
}

Table legal_documents {
  id uuid [pk]
  document_type varchar [not null]
  version varchar [not null]
  locale varchar [not null]
  content_hash varchar [not null]
  effective_at timestamptz [not null]
  retired_at timestamptz
  indexes { (document_type, version, locale) [unique] }
}

Table legal_acceptances {
  id uuid [pk]
  user_id uuid [ref: > users.id, not null]
  legal_document_id uuid [ref: > legal_documents.id, not null]
  accepted_at timestamptz [not null]
  ip_country char(2)
  indexes { (user_id, legal_document_id) [unique] }
}

Table data_export_requests {
  id uuid [pk]
  user_id uuid [ref: > users.id, not null]
  status job_status [not null]
  result_object_uri text
  expires_at timestamptz
  requested_at timestamptz [not null]
  completed_at timestamptz
  failure_code varchar
}

Table account_deletion_requests {
  id uuid [pk]
  user_id uuid [ref: > users.id, not null]
  status job_status [not null]
  requested_at timestamptz [not null]
  scheduled_purge_at timestamptz
  completed_at timestamptz
  failure_code varchar
}

Table identity_verifications {
  id uuid [pk]
  user_id uuid [ref: > users.id, not null]
  provider varchar [not null]
  provider_reference varchar [not null]
  verification_type varchar [not null]
  status verification_status [not null]
  country_code char(2)
  age_threshold int
  identity_verified boolean [not null]
  age_verified boolean [not null]
  verified_at timestamptz
  expires_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes { (provider, provider_reference) [unique] }
}

Table staff_accounts {
  id uuid [pk]
  identity_subject varchar [not null, unique]
  email_normalized varchar [not null]
  status varchar [not null]
  mfa_required boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  disabled_at timestamptz
}

Table staff_account_roles {
  staff_account_id uuid [ref: > staff_accounts.id]
  role varchar [not null]
  scope jsonb
  granted_at timestamptz [not null]
  indexes { (staff_account_id, role) [unique] }
}

Table countries {
  code char(2) [pk]
  default_currency char(3) [not null]
  default_locale varchar [not null]
  config jsonb [not null]
}

Table regions {
  id uuid [pk]
  country_code char(2) [ref: > countries.code, not null]
  name varchar [not null]
  source_code varchar
}

Table cities {
  id uuid [pk]
  region_id uuid [ref: > regions.id]
  country_code char(2) [ref: > countries.code, not null]
  name varchar [not null]
  timezone varchar [not null]
  center_geography geography
}

Table media_assets {
  id uuid [pk]
  owner_user_id uuid [ref: > users.id]
  status media_status [not null]
  media_type varchar [not null]
  storage_key text [not null, unique]
  mime_type varchar
  byte_size bigint
  width int
  height int
  moderation_metadata jsonb
  created_at timestamptz [not null]
  ready_at timestamptz
  deleted_at timestamptz
}

Table organizations {
  id uuid [pk]
  status org_status [not null]
  type varchar [not null]
  slug varchar [unique]
  display_name varchar [not null]
  description text
  country_code char(2) [ref: > countries.code]
  website_url text
  logo_media_id uuid [ref: > media_assets.id]
  verified_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table organization_members {
  id uuid [pk]
  organization_id uuid [ref: > organizations.id, not null]
  user_id uuid [ref: > users.id, not null]
  status varchar [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes { (organization_id, user_id) [unique] }
}

Table organization_member_roles {
  organization_member_id uuid [ref: > organization_members.id]
  role org_role [not null]
  granted_at timestamptz [not null]
  indexes { (organization_member_id, role) [unique] }
}

Table organization_claims {
  id uuid [pk]
  organization_id uuid [ref: > organizations.id, not null]
  claimant_user_id uuid [ref: > users.id, not null]
  status varchar [not null]
  evidence jsonb
  reviewed_by_staff_id uuid [ref: > staff_accounts.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table venues {
  id uuid [pk]
  organization_id uuid [ref: > organizations.id]
  name varchar [not null]
  country_code char(2) [ref: > countries.code, not null]
  city_id uuid [ref: > cities.id]
  address jsonb
  geography geography [not null]
  timezone varchar [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table event_categories {
  id uuid [pk]
  slug varchar [not null, unique]
  parent_id uuid [ref: > event_categories.id]
  sort_order int [not null, default: 0]
  active boolean [not null, default: true]
}

Table ingestion_sources {
  id uuid [pk]
  source_key varchar [not null, unique]
  source_type varchar [not null]
  country_code char(2) [ref: > countries.code]
  rights_metadata jsonb [not null]
  rights_review_at timestamptz
  config jsonb [not null]
  freshness_sla_seconds int
  enabled boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table organization_source_mappings {
  source_id uuid [ref: > ingestion_sources.id]
  source_organization_id varchar [not null]
  organization_id uuid [ref: > organizations.id, not null]
  created_at timestamptz [not null]
  indexes { (source_id, source_organization_id) [unique] }
}

Table venue_source_mappings {
  source_id uuid [ref: > ingestion_sources.id]
  source_venue_id varchar [not null]
  venue_id uuid [ref: > venues.id, not null]
  created_at timestamptz [not null]
  indexes { (source_id, source_venue_id) [unique] }
}

Table ingestion_runs {
  id uuid [pk]
  source_id uuid [ref: > ingestion_sources.id, not null]
  status ingestion_run_status [not null]
  connector_version varchar [not null]
  normalizer_version varchar [not null]
  classifier_version varchar
  cursor_before text
  cursor_after text
  fetched_count int [not null, default: 0]
  created_count int [not null, default: 0]
  updated_count int [not null, default: 0]
  cancelled_count int [not null, default: 0]
  error_count int [not null, default: 0]
  error_summary jsonb
  started_at timestamptz [not null]
  finished_at timestamptz
}

Table raw_event_records {
  id uuid [pk]
  ingestion_run_id uuid [ref: > ingestion_runs.id]
  source_id uuid [ref: > ingestion_sources.id, not null]
  source_event_id varchar [not null]
  source_occurrence_id varchar
  fetched_at timestamptz [not null]
  source_updated_at timestamptz
  content_hash varchar [not null]
  payload jsonb
  payload_object_uri text
  rights_metadata jsonb
  parse_status varchar [not null]
  error_code varchar
  indexes { (source_id, source_event_id, content_hash) }
}

Table events {
  id uuid [pk]
  origin event_origin [not null]
  state event_state [not null]
  access event_access [not null]
  owner_user_id uuid [ref: > users.id]
  organization_id uuid [ref: > organizations.id]
  category_id uuid [ref: > event_categories.id]
  min_age int [not null, default: 18]
  max_age int
  audience_policy jsonb [not null]
  accessibility_metadata jsonb
  version bigint [not null, default: 1]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  published_at timestamptz
}

Table private_locations {
  id uuid [pk]
  crypto_version varchar [not null]
  algorithm varchar [not null]
  kms_key_resource text [not null]
  encrypted_dek bytea [not null]
  nonce bytea [not null]
  aad_version varchar [not null]
  encrypted_payload bytea [not null]
  created_at timestamptz [not null]
  rotated_at timestamptz
  Note: 'Encrypted payload is a versioned object containing exact address/coordinates/access instructions. No public label is stored here.'
}

Table event_occurrence_templates {
  event_id uuid [pk, ref: > events.id]
  default_duration_minutes int [not null]
  default_venue_id uuid [ref: > venues.id]
  default_place_type place_type [not null]
  default_public_location_label varchar [not null]
  default_public_geography geography [not null]
  default_private_location_id uuid [ref: > private_locations.id]
  default_admission_mode admission_mode [not null]
  default_participation_mode participation_mode [not null]
  default_waitlist_policy waitlist_policy [not null]
  default_social_capacity int
  default_join_close_offset_minutes int
  updated_at timestamptz [not null]
  Note: 'CHECK: PRIVATE_HOME requires default_private_location_id; non-private normally does not reference private location. Template supplies materializer defaults.'
}

Table event_recurrences {
  event_id uuid [pk, ref: > events.id]
  frequency varchar [not null]
  interval int [not null, default: 1]
  byday varchar
  count int
  until_local timestamp
  dtstart_local timestamp [not null]
  timezone varchar [not null]
  materialized_through timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: 'CHECK: frequency DAILY/WEEKLY/MONTHLY; interval>0; COUNT/UNTIL validity; local wall-clock semantics across DST.'
}

Table event_translations {
  event_id uuid [ref: > events.id]
  locale varchar [not null]
  title varchar [not null]
  description text
  source_locale varchar
  translation_source varchar [not null]
  updated_at timestamptz [not null]
  indexes { (event_id, locale) [unique] }
}

Table event_occurrences {
  id uuid [pk]
  event_id uuid [ref: > events.id, not null]
  state occurrence_state [not null]
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  timezone varchar [not null]
  venue_id uuid [ref: > venues.id]
  place_type place_type [not null]
  public_location_label varchar [not null]
  public_geography geography [not null]
  private_location_id uuid [ref: > private_locations.id]
  admission_mode admission_mode [not null]
  participation_mode participation_mode [not null]
  waitlist_policy waitlist_policy [not null]
  social_capacity int
  join_closes_at timestamptz
  external_ticket_url text
  price_display jsonb
  policy_overrides jsonb
  version bigint [not null, default: 1]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes {
    (event_id, starts_at)
    (state, starts_at)
  }
  Note: 'CHECK: ends_at>starts_at; PRIVATE_HOME requires private_location_id; generic/public location lives here; no online/hybrid V1.'
}

Table event_source_links {
  id uuid [pk]
  source_id uuid [ref: > ingestion_sources.id, not null]
  source_event_id varchar [not null]
  event_id uuid [ref: > events.id, not null]
  source_url text
  rights_metadata jsonb
  source_updated_at timestamptz
  last_fetched_at timestamptz [not null]
  content_hash varchar
  last_raw_record_id uuid [ref: > raw_event_records.id]
  indexes { (source_id, source_event_id) [unique] }
}

Table occurrence_source_links {
  id uuid [pk]
  source_id uuid [ref: > ingestion_sources.id, not null]
  source_occurrence_id varchar [not null]
  occurrence_id uuid [ref: > event_occurrences.id, not null]
  source_updated_at timestamptz
  last_fetched_at timestamptz [not null]
  indexes { (source_id, source_occurrence_id) [unique] }
}

Table event_aliases {
  alias_event_id uuid [pk]
  canonical_event_id uuid [ref: > events.id, not null]
  reason varchar [not null]
  merged_at timestamptz [not null]
  merged_by_staff_id uuid [ref: > staff_accounts.id]
  Note: 'Prevent self/cycles/chains; resolve/flatten to live canonical.'
}

Table occurrence_aliases {
  alias_occurrence_id uuid [pk]
  canonical_occurrence_id uuid [ref: > event_occurrences.id, not null]
  reason varchar [not null]
  merged_at timestamptz [not null]
}

Table event_media {
  event_id uuid [ref: > events.id]
  media_asset_id uuid [ref: > media_assets.id]
  sort_order int [not null]
  indexes { (event_id, media_asset_id) [unique] }
}

Table participations {
  id uuid [pk]
  occurrence_id uuid [ref: > event_occurrences.id, not null]
  user_id uuid [ref: > users.id, not null]
  state participation_state [not null]
  joined_at timestamptz
  cancelled_at timestamptz
  attendance_source varchar
  updated_at timestamptz [not null]
  indexes { (occurrence_id, user_id) [unique] }
}

Table waitlist_entries {
  id uuid [pk]
  occurrence_id uuid [ref: > event_occurrences.id, not null]
  user_id uuid [ref: > users.id, not null]
  ordinal bigint [not null]
  state varchar [not null]
  created_at timestamptz [not null]
  indexes {
    (occurrence_id, user_id) [unique]
    (occurrence_id, ordinal) [unique]
  }
}

Table waitlist_offers {
  id uuid [pk]
  waitlist_entry_id uuid [ref: > waitlist_entries.id, not null]
  expires_at timestamptz [not null]
  status varchar [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: 'Migration adds partial UNIQUE for at most one active offer per waitlist_entry.'
}

Table invitations {
  id uuid [pk]
  occurrence_id uuid [ref: > event_occurrences.id, not null]
  invited_user_id uuid [ref: > users.id]
  invited_by_user_id uuid [ref: > users.id, not null]
  token_hash varchar
  status varchar [not null]
  expires_at timestamptz
  created_at timestamptz [not null]
}

Table check_ins {
  id uuid [pk]
  occurrence_id uuid [ref: > event_occurrences.id, not null]
  user_id uuid [ref: > users.id, not null]
  method varchar [not null]
  confirmed_by_user_id uuid [ref: > users.id]
  checked_in_at timestamptz [not null]
  indexes { (occurrence_id, user_id) [unique] }
}

Table pods {
  id uuid [pk]
  occurrence_id uuid [ref: > event_occurrences.id, not null]
  created_by_user_id uuid [ref: > users.id, not null]
  state pod_state [not null]
  participation_mode participation_mode [not null]
  title varchar [not null]
  description text
  capacity int
  meeting_point jsonb
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table pod_members {
  pod_id uuid [ref: > pods.id]
  user_id uuid [ref: > users.id]
  state pod_member_state [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes { (pod_id, user_id) [unique] }
}

Table connections {
  id uuid [pk]
  user_low_id uuid [ref: > users.id, not null]
  user_high_id uuid [ref: > users.id, not null]
  status varchar [not null]
  created_at timestamptz [not null]
  indexes { (user_low_id, user_high_id) [unique] }
  Note: 'CHECK distinct canonical ordered pair.'
}

Table conversations {
  id uuid [pk]
  type conversation_type [not null]
  occurrence_id uuid [ref: > event_occurrences.id]
  pod_id uuid [ref: > pods.id]
  connection_id uuid [ref: > connections.id]
  organization_id uuid [ref: > organizations.id]
  created_at timestamptz [not null]
  Note: 'CHECK exactly one context column matching conversation type.'
}

Table conversation_members {
  conversation_id uuid [ref: > conversations.id]
  user_id uuid [ref: > users.id]
  role varchar [not null]
  joined_at timestamptz [not null]
  left_at timestamptz
  indexes { (conversation_id, user_id) [unique] }
}

Table messages {
  id uuid [pk]
  conversation_id uuid [ref: > conversations.id, not null]
  sender_user_id uuid [ref: > users.id, not null]
  type varchar [not null]
  body text
  metadata jsonb
  status varchar [not null]
  content_version bigint [not null, default: 1]
  created_at timestamptz [not null]
  edited_at timestamptz
  deleted_at timestamptz
  indexes { (conversation_id, created_at, id) }
}

Table message_media {
  message_id uuid [ref: > messages.id]
  media_asset_id uuid [ref: > media_assets.id]
  indexes { (message_id, media_asset_id) [unique] }
}

Table blocks {
  blocker_user_id uuid [ref: > users.id]
  blocked_user_id uuid [ref: > users.id]
  created_at timestamptz [not null]
  indexes { (blocker_user_id, blocked_user_id) [unique] }
  Note: 'CHECK blocker != blocked.'
}

Table feedback {
  id uuid [pk]
  occurrence_id uuid [ref: > event_occurrences.id, not null]
  author_user_id uuid [ref: > users.id, not null]
  subject_user_id uuid [ref: > users.id, not null]
  structured jsonb [not null]
  would_meet_again boolean
  private_note text
  safety_flag boolean [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes { (occurrence_id, author_user_id, subject_user_id) [unique] }
}

Table share_plans {
  id uuid [pk]
  user_id uuid [ref: > users.id, not null]
  occurrence_id uuid [ref: > event_occurrences.id, not null]
  token_hash varchar [not null, unique]
  include_exact_location boolean [not null, default: false]
  expires_at timestamptz [not null]
  revoked_at timestamptz
  created_at timestamptz [not null]
}

Table reports {
  id uuid [pk]
  reporter_user_id uuid [ref: > users.id, not null]
  target_type varchar [not null]
  target_id uuid [not null]
  reason_code varchar [not null]
  description text
  status report_status [not null]
  created_at timestamptz [not null]
}

Table moderation_cases {
  id uuid [pk]
  state case_state [not null]
  severity varchar [not null]
  primary_target_type varchar [not null]
  primary_target_id uuid [not null]
  assigned_staff_id uuid [ref: > staff_accounts.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table moderation_case_reports {
  case_id uuid [ref: > moderation_cases.id]
  report_id uuid [ref: > reports.id]
  linked_by_staff_id uuid [ref: > staff_accounts.id]
  linked_at timestamptz [not null]
  indexes {
    (case_id, report_id) [unique]
    report_id [unique]
  }
}

Table moderation_evidence {
  id uuid [pk]
  case_id uuid [ref: > moderation_cases.id, not null]
  evidence_type varchar [not null]
  source_entity_type varchar
  source_entity_id uuid
  source_version bigint
  content_hash varchar
  snapshot_object_uri text
  reference jsonb
  classification varchar [not null]
  created_at timestamptz [not null]
  Note: 'Evidence snapshot is immutable/minimized; do not depend on later mutable message/profile/event content.'
}

Table moderation_actions {
  id uuid [pk]
  case_id uuid [ref: > moderation_cases.id, not null]
  action_type varchar [not null]
  reason_code varchar [not null]
  target_type varchar [not null]
  target_id uuid [not null]
  starts_at timestamptz [not null]
  ends_at timestamptz
  appealable boolean [not null]
  actor_staff_id uuid [ref: > staff_accounts.id]
  created_at timestamptz [not null]
}

Table appeals {
  id uuid [pk]
  moderation_action_id uuid [ref: > moderation_actions.id, not null]
  appellant_user_id uuid [ref: > users.id, not null]
  state appeal_state [not null]
  statement text
  reviewed_by_staff_id uuid [ref: > staff_accounts.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table notifications {
  id uuid [pk]
  user_id uuid [ref: > users.id, not null]
  category varchar [not null]
  template_key varchar [not null]
  payload jsonb [not null]
  dedup_key varchar
  created_at timestamptz [not null]
  read_at timestamptz
  archived_at timestamptz
  indexes { (user_id, dedup_key) }
}

Table notification_deliveries {
  id uuid [pk]
  notification_id uuid [ref: > notifications.id, not null]
  channel varchar [not null]
  destination_ref varchar
  status delivery_status [not null]
  attempts int [not null, default: 0]
  provider_reference varchar
  last_error_code varchar
  next_attempt_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes { (notification_id, channel, destination_ref) [unique] }
}

Table subscriptions {
  id uuid [pk]
  organization_id uuid [ref: > organizations.id]
  user_id uuid [ref: > users.id]
  provider varchar [not null]
  provider_customer_id varchar
  provider_subscription_id varchar
  status varchar [not null]
  currency char(3)
  amount_minor bigint
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: 'CHECK exactly one supported subscriber subject where required.'
}

Table billing_transactions {
  id uuid [pk]
  organization_id uuid [ref: > organizations.id]
  user_id uuid [ref: > users.id]
  provider varchar [not null]
  provider_transaction_id varchar [not null]
  type varchar [not null]
  status varchar [not null]
  amount_minor bigint [not null]
  currency char(3) [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes { (provider, provider_transaction_id) [unique] }
}

Table entitlements {
  id uuid [pk]
  subject_type varchar [not null]
  subject_id uuid [not null]
  key varchar [not null]
  valid_from timestamptz [not null]
  valid_until timestamptz
  source varchar [not null]
  indexes { (subject_type, subject_id, key, valid_from) [unique] }
}

Table operational_flags {
  key varchar [pk]
  value jsonb [not null]
  environment varchar [not null]
  safety_critical boolean [not null, default: false]
  requires_two_person_enable boolean [not null, default: false]
  version bigint [not null, default: 1]
  last_reason varchar [not null]
  updated_by_staff_id uuid [ref: > staff_accounts.id]
  updated_at timestamptz [not null]
  Note: 'Updates use optimistic concurrency on version. Disabling may be easier than re-enabling safety-critical flags.'
}

Table operational_flag_change_requests {
  id uuid [pk]
  flag_key varchar [ref: > operational_flags.key, not null]
  expected_version bigint [not null]
  proposed_value jsonb [not null]
  reason varchar [not null]
  status flag_change_status [not null]
  requested_by_staff_id uuid [ref: > staff_accounts.id, not null]
  approved_by_staff_id uuid [ref: > staff_accounts.id]
  created_at timestamptz [not null]
  expires_at timestamptz
  applied_at timestamptz
  Note: 'For two-person changes requester and approver must differ.'
}

Table client_policies {
  id uuid [pk]
  platform varchar [not null]
  environment varchar [not null]
  minimum_supported_version varchar [not null]
  recommended_version varchar
  latest_known_version varchar
  minimum_runtime_version varchar
  force_update boolean [not null, default: false]
  required_capabilities jsonb [not null]
  effective_at timestamptz [not null]
  updated_by_staff_id uuid [ref: > staff_accounts.id]
  updated_at timestamptz [not null]
  indexes { (platform, environment, effective_at) }
}

Table audit_logs {
  id uuid [pk]
  stream_key varchar [not null]
  actor_type varchar [not null]
  actor_id uuid
  action varchar [not null]
  target_type varchar
  target_id uuid
  reason_code varchar
  metadata jsonb
  request_id varchar
  previous_hash varchar
  entry_hash varchar [not null]
  created_at timestamptz [not null]
  indexes { (stream_key, created_at, id) }
  Note: 'Application role INSERT-only. Critical audit also exported to independent retention-controlled sink.'
}

Table outbox_events {
  id uuid [pk]
  event_type varchar [not null]
  schema_version int [not null]
  aggregate_type varchar [not null]
  aggregate_id uuid [not null]
  aggregate_version bigint
  actor_type varchar
  actor_id uuid
  country_code char(2)
  payload jsonb [not null]
  correlation_id varchar [not null]
  causation_id varchar
  occurred_at timestamptz [not null]
  published_at timestamptz
  attempts int [not null, default: 0]
  indexes { (published_at, occurred_at) }
}

Table processed_events {
  consumer_name varchar [not null]
  event_id uuid [not null]
  processed_at timestamptz [not null]
  indexes { (consumer_name, event_id) [unique] }
}

Table idempotency_keys {
  id uuid [pk]
  actor_scope varchar [not null]
  operation varchar [not null]
  key varchar [not null]
  request_hash varchar [not null]
  outcome jsonb
  expires_at timestamptz [not null]
  created_at timestamptz [not null]
  indexes { (actor_scope, operation, key) [unique] }
}
